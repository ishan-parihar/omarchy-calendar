[Unit]
Description=Sync Google Calendar into the Omarchy calendar widget
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A user service starts with a minimal PATH, so a gog installed by
# `go install` (~/go/bin) would be invisible. sync/setup writes an absolute
# path into calendar-sync.json; this list is the fallback for everyone else.
Environment=PATH=%h/go/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Optional keyring env for gog installs using the encrypted file backend
# (GOG_KEYRING_BACKEND/GOG_KEYRING_PASSWORD). Written by sync/setup when
# those variables are present in its environment. The leading dash means a
# missing file is fine, which is the common OS-keyring case.
EnvironmentFile=-%h/.config/omarchy/calendar-gog.env
ExecStart=%h/.config/omarchy/plugins/omarchy-calendar/sync/omarchy-calendar-sync
# A failed run is deliberately allowed to surface as a failed unit. The
# sync leaves the previous events file intact either way, and a user
# needs `systemctl --user status` to show that something is wrong.
