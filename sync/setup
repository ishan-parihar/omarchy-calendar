#!/usr/bin/env bash
# Onboarding for the Google Calendar sync (gog edition).
#
# First it looks for Google auth gog already has and reuses it: no OAuth
# client, no credentials, no browser when gog is already logged in. Only
# when nothing usable exists does it drive `gog auth setup`, which automates
# project creation and API enablement. Google exposes no API for the consent
# screen, publishing the app, or creating the OAuth client, so those stay
# manual. Ends by writing the config and installing the systemd timer.

set -euo pipefail

ACCOUNT="${1:-${PROFILE_ACCOUNT:-}}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SYNC_BIN="$SCRIPT_DIR/omarchy-calendar-sync"

step() { printf '\n==> %s\n' "$1"; }

# `read` returns non-zero at EOF, and under `set -e` that killed the whole
# script at the very first prompt with no message at all. Anyone running this
# through a pipe, a wrapper, or any non-interactive shell got as far as the
# first prompt and no further, silently.
pause() {
  if [ ! -t 0 ]; then
    printf '\n  Not a terminal, so not pausing. Do the step above before continuing.\n'
    return 0
  fi
  printf '\nPress Enter when done. '
  read -r _ || true
}

if [ ! -t 0 ]; then
  cat <<'EOF'
Warning: stdin is not a terminal.

Some steps below have to be done by hand in the Google Cloud Console,
and this run cannot pause to wait for you. Run this directly in a terminal for
the guided flow.

EOF
fi

command -v gog >/dev/null || {
  cat <<'EOF'
gog is required: https://gogcli.sh

  go install github.com/openclaw/gogcli/cmd/gog@latest

Then run this script again.
EOF
  exit 1
}

# Prints the account email when `gog calendar calendars` works for it:
# JSON with a calendars list on stdout means real access, anything else
# (usage errors also exit 0 on stdout) means no.
probe_account() {
  local account="$1"
  local args=()
  [ -n "$account" ] && args+=(--account "$account")
  if gog "${args[@]}" --no-input --readonly calendar calendars \
      --all --max 1 --json 2>/dev/null \
    | python3 -c 'import json, sys; sys.exit(0 if isinstance(json.load(sys.stdin).get("calendars"), list) else 1)' \
      2>/dev/null; then
    printf '%s' "$account"
    return 0
  fi
  return 1
}

step "Reusing Google auth gog already has, if any"
# An explicit account wins when it works; otherwise the default account is
# tried, then every stored account in turn. gog owns credentials and tokens,
# this script never touches them. An empty ACCOUNT means gog's default.
REUSED=""
if [ -n "$ACCOUNT" ]; then
  if probe_account "$ACCOUNT" >/dev/null; then
    REUSED="$ACCOUNT"
  else
    echo "  $ACCOUNT has no working calendar access, will log it in below."
    ACCOUNT=""
  fi
fi
if [ -z "$REUSED" ]; then
  if probe_account "" >/dev/null; then
    REUSED="default"
  else
    while read -r candidate; do
      [ -n "$candidate" ] || continue
      if probe_account "$candidate" >/dev/null; then
        ACCOUNT="$candidate"
        REUSED="$candidate"
        break
      fi
    done < <(gog auth list --json 2>/dev/null \
      | python3 -c 'import json, sys
try:
    accounts = json.load(sys.stdin).get("accounts", [])
except ValueError:
    accounts = []
for a in accounts:
    if isinstance(a, dict):
        print(a.get("email") or a.get("account") or a.get("name") or "")' 2>/dev/null)
  fi
fi

if [ -n "$REUSED" ]; then
  echo "  reusing gog account with calendar access: $REUSED"
else
  step "No usable gog auth found, setting it up"
  if [ -z "$ACCOUNT" ] && [ ! -t 0 ]; then
    echo "  no Google account given and stdin is not a terminal. Re-run as:"
    echo "    $0 you@gmail.com"
    exit 1
  fi
  if [ -z "$ACCOUNT" ]; then
    printf 'Google account email (e.g. you@gmail.com): '
    read -r ACCOUNT
  fi

  # gog automates project creation and API enablement when gcloud exists;
  # otherwise those two stay manual. Either way the consent screen,
  # publishing, and the OAuth client have no API and stay manual.
  if command -v gcloud >/dev/null; then
    PROJECT_ID="omarchy-cal-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
    echo "  creating Cloud project $PROJECT_ID and enabling the Calendar API"
    gog auth setup "$ACCOUNT" --services calendar --readonly \
      --gcloud-project "$PROJECT_ID" --create-project --enable-apis --open-console
  else
    cat <<'EOF'
  gcloud is not installed, so two extra steps are manual (one time only):

    1. Create a project: https://console.cloud.google.com/projectcreate
    2. Enable the Calendar API: https://console.cloud.google.com/apis/library
EOF
    PROJECT_ID=""
  fi

  cat <<EOF
  Two things Google exposes no API for (one time only):

    1. Consent screen as External with your own email:
       https://console.cloud.google.com/auth/branding
    2. Publish the app: https://console.cloud.google.com/auth/audience
       Under "Publishing status", click "Publish app". In Testing, Google
       expires refresh tokens after 7 days and your calendar silently stops
       updating. Unverified production apps show a one time warning and then
       work indefinitely for personal use.
    3. Create a Desktop app OAuth client:
       https://console.cloud.google.com/auth/clients
       Then "Download JSON". The secret is not shown again after you close
       that dialog.
EOF
  pause

  downloaded=$(find "$HOME/Downloads" -maxdepth 1 -name 'client_secret_*.json' -print -quit 2>/dev/null || true)
  if [ -n "$downloaded" ]; then
    echo "  storing $downloaded and signing in"
    # --readonly requests read-only OAuth scopes. The browser tab shows
    # exactly what is granted: tick calendar access before continuing.
    gog auth setup "$ACCOUNT" --services calendar --readonly \
      ${PROJECT_ID:+--gcloud-project "$PROJECT_ID"} \
      --credentials "$downloaded" --login
  else
    printf 'Path to the downloaded client_secret JSON: '
    read -r manual
    # shellcheck disable=SC2088
    gog auth setup "$ACCOUNT" --services calendar --readonly \
      ${PROJECT_ID:+--gcloud-project "$PROJECT_ID"} \
      --credentials "${manual/#\~/$HOME}" --login
  fi

  if ! probe_account "$ACCOUNT" >/dev/null; then
    cat <<EOF

Calendar access still does not work. Most common reasons:

  - The calendar checkbox on the consent screen was left unticked. Re-run:
      gog auth add $ACCOUNT --services calendar --readonly --force-consent
  - The Calendar API is not enabled for your Cloud project.
  - The app is still in Testing and the refresh token expired after 7 days.
    Publish it (step 2 above), then log in again.
EOF
    exit 1
  fi
  echo "  calendar access works for $ACCOUNT"
fi

step "Recording your account and where gog lives"
# The timer runs without your shell PATH, so the bare name is not enough.
gog_path=$(command -v gog)
config="$HOME/.config/omarchy/calendar-sync.json"
mkdir -p "$(dirname "$config")"
python3 - "$config" "$gog_path" "$ACCOUNT" <<'PYEOF'
import json, pathlib, sys

path, gog_path, account = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
config = {}
if path.exists():
    try:
        config = json.loads(path.read_text())
    except ValueError:
        config = {}
config["gogPath"] = gog_path
config["account"] = account
path.write_text(json.dumps(config, indent=2) + "\n")
print("  gogPath set to", gog_path)
print("  account set to", account or "gog default")
PYEOF

step "Installing the systemd timer"
mkdir -p "$HOME/.config/systemd/user"
cp "$SCRIPT_DIR/systemd/omarchy-calendar-sync."{service,timer} "$HOME/.config/systemd/user/"
# The shipped unit assumes the standard plugin directory. Point it at wherever
# this checkout actually lives, so a hand-cloned repo works too.
sed -i "s|^ExecStart=.*|ExecStart=$SYNC_BIN|" "$HOME/.config/systemd/user/omarchy-calendar-sync.service"
systemctl --user daemon-reload
systemctl --user enable --now omarchy-calendar-sync.timer

step "Running the first sync"
systemctl --user start omarchy-calendar-sync.service || true
systemctl --user status omarchy-calendar-sync.service --no-pager || true

cat <<EOF

Done. Events land in ~/.local/state/omarchy/calendar-events.json every 5 minutes.

  Logs:    journalctl --user -u omarchy-calendar-sync -f
  Choose which calendars to show: click the clock, then the gear icon.
EOF
