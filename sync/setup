#!/usr/bin/env bash
# Interactive onboarding for the Google Calendar sync (gog edition).
#
# Automates: gog credential storage, the scoped login, the config file, and
# the systemd timer.
# Cannot automate: the OAuth consent screen and creating the Desktop OAuth
# client. Google exposes no API for those.

set -euo pipefail

PROFILE_ACCOUNT="${PROFILE_ACCOUNT:-}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SYNC_BIN="$SCRIPT_DIR/omarchy-calendar-sync"
SCOPE="calendar.readonly"

step() { printf '\n==> %s\n' "$1"; }

# `read` returns non-zero at EOF, and under `set -e` that killed the whole
# script at the very first prompt with no message at all. Anyone running this
# through a pipe, a wrapper, or any non-interactive shell got as far as the
# first Google Console instruction and no further, silently.
pause() {
  if [ ! -t 0 ]; then
    printf '\n  Not a terminal, so not pausing. Do the step above before continuing.\n'
    return 0
  fi
  printf '\nPress Enter when done. '
  read -r _ || true
}

if [ ! -t 0 ]; then
  cat <<'EOF'
Warning: stdin is not a terminal.

Some steps below have to be done by hand in the Google Cloud Console,
and this run cannot pause to wait for you. Run this directly in a terminal for
the guided flow.

EOF
fi

command -v gog >/dev/null || {
  cat <<'EOF'
gog is required: https://gogcli.sh

  go install github.com/openclaw/gogcli/cmd/gog@latest

Then run this script again.
EOF
  exit 1
}

step "Manual step 1 of 2: create an OAuth client"
cat <<EOF
gog talks to Google as you, using your own Cloud project. One time only:

  1. Create a project: https://console.cloud.google.com/projectcreate
  2. Enable the Calendar API: https://console.cloud.google.com/apis/library
     (search "Google Calendar API", click Enable)
  3. Configure the OAuth consent screen as External with your own email:
     https://console.cloud.google.com/auth/branding
  4. Publish the app: https://console.cloud.google.com/auth/audience
     Under "Publishing status", click "Publish app". In Testing, Google
     expires refresh tokens after 7 days and your calendar silently stops
     updating. Unverified production apps show a one time warning and then
     work indefinitely for personal use.
  5. Create a Desktop app OAuth client:
     https://console.cloud.google.com/auth/clients
     Then click "Download JSON". The secret is not shown again after you
     close that dialog.

Full guide: https://gogcli.sh (quickstart) or
  gog auth setup --help
EOF
pause

step "Storing the OAuth client"
downloaded=$(find "$HOME/Downloads" -maxdepth 1 -name 'client_secret_*.json' -print -quit 2>/dev/null || true)
if [ -n "$downloaded" ]; then
  gog auth credentials "$downloaded"
else
  printf 'Path to the downloaded client_secret JSON: '
  read -r manual
  # shellcheck disable=SC2088
  gog auth credentials "${manual/#\~/$HOME}"
fi

if [ -z "$PROFILE_ACCOUNT" ]; then
  printf 'Google account email (e.g. you@gmail.com): '
  read -r PROFILE_ACCOUNT
fi

step "Signing in with read-only calendar access ($PROFILE_ACCOUNT)"
# --readonly requests read-only OAuth scopes, matching the old
# calendar.readonly posture. The browser tab shows exactly what is granted.
gog auth add "$PROFILE_ACCOUNT" --services calendar --readonly

step "Verifying calendar access"
# Surface a real error rather than reporting zero calendars on failure.
if ! gog --account "$PROFILE_ACCOUNT" --no-input --readonly \
    calendar calendars --all --json 2>/dev/null \
  | python3 -c '
import json, sys

payload = json.load(sys.stdin)
error = payload.get("error")
if error:
    print("  calendar access failed:", error)
    raise SystemExit(1)

count = len(payload.get("calendars", []))
print(" ", count, "calendars reachable")
if count == 0:
    print("  That is unusual. Check that this Google account has any calendars.")
'; then
  cat <<EOF

Calendar access failed. Most common reasons:

  - The calendar checkbox on the consent screen was left unticked. Re-run:
      gog auth add $PROFILE_ACCOUNT --services calendar --readonly --force-consent
  - The Calendar API is not enabled for your Cloud project (step 1.2 above).
  - The app is still in Testing and the refresh token expired after 7 days.
    Publish it (step 1.4 above), then log in again.
EOF
  exit 1
fi

step "Recording your account and where gog lives"
# The timer runs without your shell PATH, so the bare name is not enough.
gog_path=$(command -v gog)
config="$HOME/.config/omarchy/calendar-sync.json"
mkdir -p "$(dirname "$config")"
python3 - "$config" "$gog_path" "$PROFILE_ACCOUNT" <<'PYEOF'
import json, pathlib, sys

path, gog_path, account = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
config = {}
if path.exists():
    try:
        config = json.loads(path.read_text())
    except ValueError:
        config = {}
config["gogPath"] = gog_path
config["account"] = account
path.write_text(json.dumps(config, indent=2) + "\n")
print("  gogPath set to", gog_path)
print("  account set to", account)
PYEOF

step "Installing the systemd timer"
mkdir -p "$HOME/.config/systemd/user"
cp "$SCRIPT_DIR/systemd/omarchy-calendar-sync."{service,timer} "$HOME/.config/systemd/user/"
# The shipped unit assumes the standard plugin directory. Point it at wherever
# this checkout actually lives, so a hand-cloned repo works too.
sed -i "s|^ExecStart=.*|ExecStart=$SYNC_BIN|" "$HOME/.config/systemd/user/omarchy-calendar-sync.service"
systemctl --user daemon-reload
systemctl --user enable --now omarchy-calendar-sync.timer

step "Running the first sync"
systemctl --user start omarchy-calendar-sync.service || true
systemctl --user status omarchy-calendar-sync.service --no-pager || true

cat <<EOF

Done. Events land in ~/.local/state/omarchy/calendar-events.json every 5 minutes.

  Logs:    journalctl --user -u omarchy-calendar-sync -f
  Choose which calendars to show: click the clock, then the gear icon.
EOF
